# HTTP API port. HOST=127.0.0.1 when running behind nginx (see deploy/).
PORT=4000
HOST=0.0.0.0

# PostgreSQL on the Ubuntu server. Do not commit the actual .env file.
DATABASE_URL=postgresql://road_user:CHANGE_THIS_PASSWORD@127.0.0.1:5432/road_db

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret

# development = OTP is written to the server log
# test        = every phone number receives OTP_TEST_CODE (public test builds only)
# twilio      = OTP is sent by SMS through Twilio (TWILIO_* below)
OTP_MODE=development
OTP_TEST_CODE=

# Twilio (OTP_MODE=twilio). Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a Messaging Service SID (recommended) or a Twilio sender number/ID.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Prefixed to numbers entered without a country code (99112233 -> +97699112233).
SMS_DEFAULT_COUNTRY_CODE=+976
