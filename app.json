{
  "expo": {
    "name": "ROAD",
    "slug": "road-driver-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": {
      "name": "ROAD — Замд ганцаараа биш",
      "shortName": "ROAD"
    },
    "android": {
      "package": "mn.road.driver"
    },
    "ios": {
      "bundleIdentifier": "mn.road.driver",
      "supportsTablet": false
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1118"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Профайлын зураг сонгохын тулд ROAD таны зургийн санд хандана.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ROAD-д Face ID-аар хурдан нэвтрэхийн тулд таны царайг ашиглана."
        }
      ]
    ]
  }
}
